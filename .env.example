# First run: copy to .env and replace all CHANGE_ME values.
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
# Public HTTPS URL serving the /media path; must be accessible to Meta servers.
# For deployment, typically same public hostname as APP_BASE_URL.
PUBLIC_BASE_URL=https://your-domain.example
ADMIN_PASSWORD=CHANGE_ME_use_a_long_unique_password
# Generate each separately: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=CHANGE_ME_base64_secret
ENCRYPTION_KEY=CHANGE_ME_base64_32_byte_key

# Meta Unified Login — new Meta apps, recommended.
# Meta > App Settings > Basic (Meta App ID and App Secret).
# Meta > Use Cases > Instagram API > API setup with Unified login:
# Copy the selected Instagram Login Compatible Configuration ID.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=

# The exact HTTPS redirect URL saved in Meta Unified Login.
# For your existing Railway deployment:
INSTAGRAM_REDIRECT_URI=https://zaininsta-studio-production.up.railway.app/auth/instagram/callback
GRAPH_VERSION=v27.0

# Optional legacy Instagram Login support (for older apps only).
# Omit these for a new Unified Login app; do not copy Meta App ID here.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Can also be /opt/yt/bin/yt-dlp (Docker default).
YT_DLP_BIN=yt-dlp
